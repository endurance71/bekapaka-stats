generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model KalkSeason {
  id           String   @id
  slug         String   @unique
  label        String
  divisionPath String   @default("dzial,dywizja-2,4.html")
  isActive     Boolean  @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leagueTeams   LeagueTeam[]
  leagueMatches LeagueMatch[]
  kalkPlayers   KalkPlayer[]
  kalkTeams     KalkTeam[]
  kalkMatches   KalkMatch[]
  playerGameLogs KalkPlayerGameLog[]
  games         Game[]
  preferences   PlayerSeasonPreference[]
  syncRuns      KalkSyncRun[]
  sectionSnapshots KalkSectionSnapshot[]
}

model Game {
  id          String   @id @default(uuid())
  seasonId    String?
  season      KalkSeason? @relation(fields: [seasonId], references: [id])
  date        DateTime
  opponent    String
  homeAway    String   @default("home") // "home" | "away"
  result      String?  // "W" | "L" | null (if not played yet)
  scoreUs     Int?
  scoreThem   Int?
  
  // Statystyki zespołowe
  teamStats   Json?
  
  // Box score (statystyki zawodników)
  playerStats Json?
  
  // Notatki i analiza
  notes       String?
  mvp         String?
  videoUrl    String?
  tags        String[] @default([])
  
  // Stare pole dla kompatybilności wstecznej
  data        Json?

  // Analiza AI (Gemini)
  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  aiSummaryModel String?
  aiSummaryHash  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RosterPlayer {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  number       Int?
  position     String?  // "PG", "SG", "SF", "PF", "C"
  birthDate    String?
  heightCm     Int?
  starter      Boolean  @default(false)
  
  // Powiązanie z KALK
  kalkPlayerId String?  @unique
  kalkPlayer   KalkPlayer? @relation(fields: [kalkPlayerId], references: [id])
  
  // Statystyki (obliczane z meczów)
  gamesPlayed  Int      @default(0)
  ppg          Float    @default(0)
  rpg          Float    @default(0)
  apg          Float    @default(0)
  fgPercentage Float    @default(0)
  threePercentage Float @default(0)
  ftPercentage Float    @default(0)
  
  // Advanced Stats
  tsPercentage Float    @default(0)
  eFgPercentage Float   @default(0)
  plusMinus    Float    @default(0)
  
  // Raw Totals (for aggregation)
  pts          Int      @default(0)
  fgm          Int      @default(0)
  fga          Int      @default(0)
  threePm      Int      @default(0)
  threePa      Int      @default(0)
  ftm          Int      @default(0)
  fta          Int      @default(0)
  orb          Int      @default(0)
  drb          Int      @default(0)
  reb          Int      @default(0)
  ast          Int      @default(0)
  stl          Int      @default(0)
  blk          Int      @default(0)
  tov          Int      @default(0)
  
  // Cele osobiste
  goals        Json?    // { "ppg": 25, "fgPercentage": 50, "turnovers": 3 }
  
  // Stare pole dla kompatybilności
  data         Json?

  // Analiza rozwoju AI (Gemini)
  aiDevelopmentSummary String?   @db.Text
  aiDevelopmentAt      DateTime?
  aiDevelopmentModel   String?
  aiDevelopmentHash    String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth
  username     String?  @unique
  password     String?
  role         String   @default("USER") // "USER" | "ADMIN"

  // Ostatnia aktywność w panelu (autoryzowane żądania API)
  lastActivityAt DateTime?
  lastActivityIp String?

  seasonPreference PlayerSeasonPreference?
}

model PlayerSeasonPreference {
  rosterPlayerId String   @id
  seasonId       String
  rosterPlayer   RosterPlayer @relation(fields: [rosterPlayerId], references: [id], onDelete: Cascade)
  season         KalkSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(uuid())
  username  String
  success   Boolean
  ipAddress String?
  timestamp DateTime @default(now())
}

model KalkPlayer {
  id            String   @id
  seasonId      String
  season        KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  team          String?
  pointsTotal   Float?
  pointsAverage Float?
  matchesPlayed Int?
  eval          Float?
  profileUrl    String?
  threePointStats String? // e.g. "14/40 (35%)"
  raw           Json?
  
  // Nowe kategorie statystyk ligowych
  stealsTotal      Float?
  stealsAverage    Float?
  blocksTotal      Float?
  blocksAverage    Float?
  reboundsTotal    Float?
  reboundsAverage  Float?
  assistsTotal     Float?
  assistsAverage   Float?
  threePointsMade  Int?
  threePointsAttempted Int?
  threePointsPct   Float?

  turnoversTotal     Float?
  turnoversAverage   Float?
  foulsTotal         Float?
  foulsAverage       Float?
  minutesTotal       Float?
  minutesAverage     Float?
  twoPointsPct       Float?
  ftPct              Float?
  attackIndex        Float?
  defenseIndex       Float?

  // Relacja do RosterPlayer
  rosterPlayer  RosterPlayer?
  gameLogs      KalkPlayerGameLog[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KalkTeam {
  id         String
  seasonId   String
  season     KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  captain    String?
  colors     String?
  sponsors   String?
  profileUrl String?
  playerIds  String[] @default([])
  raw        Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([seasonId, id])
}

model KalkMatch {
  id             String
  seasonId       String
  season         KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug           String
  date           DateTime
  roundCode      String?
  matchNumber    Int?
  homeTeamId     String?
  guestTeamId    String?
  homeTeamName   String
  guestTeamName  String
  scoreHome      Int?
  scoreAway      Int?
  isFinished     Boolean  @default(false)
  referees       String?
  statistician   String?
  boxScore       Json
  meta           Json?
  contentHash    String?
  scrapedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  playerGameLogs KalkPlayerGameLog[]

  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  aiSummaryModel String?
  aiSummaryHash  String?

  @@unique([seasonId, id])
}

model KalkPlayerGameLog {
  id             String   @id @default(cuid())
  seasonId       String
  season         KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  kalkPlayerId   String
  kalkPlayer     KalkPlayer @relation(fields: [kalkPlayerId], references: [id], onDelete: Cascade)
  kalkMatchId    String
  kalkMatch      KalkMatch @relation(fields: [seasonId, kalkMatchId], references: [seasonId, id], onDelete: Cascade)
  teamName       String
  opponentName   String
  isWin          Boolean?
  stats          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([seasonId, kalkPlayerId, kalkMatchId])
}

model KalkScrapeRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  finishedAt DateTime?
  status     String
  message    String?
  filePath   String
  newPlayers Json?
  log        Json?
}

model KalkSyncRun {
  id               String   @id @default(cuid())
  seasonId         String?
  season           KalkSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  mode             String
  trigger          String?
  status           String
  httpEstimate     Int?
  sectionsChanged  String[] @default([])
  probeHashes      Json?
  errorMessage     String?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
}

model KalkSectionSnapshot {
  id          String   @id @default(cuid())
  seasonId    String
  season      KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  section     String
  contentHash String
  payload     Json
  fetchedAt   DateTime @default(now())

  @@unique([seasonId, section])
}

model Training {
  id         String   @id @default(uuid())
  date       DateTime
  focus      String[] @default([]) // ["rzuty-wolne", "obrona-pilki"]
  attendance Json?    // { "present": ["id1", "id2"], "absent": ["id3"] }
  notes      String?
  duration   Int?     // minuty
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Play {
  id          String   @id @default(uuid())
  name        String
  category    String   // "offense" | "defense" | "fastbreak"
  diagram     String?  // URL do diagramu lub SVG
  description String?
  videoUrl    String?
  
  // Statystyki skuteczności
  attempts    Int      @default(0)
  successes   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeagueTeam {
  id            String   @id @default(uuid())
  seasonId      String
  season        KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  phase         String   @default("regular") // "regular" | "playout"
  matches       Int      @default(0)
  points        Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  pointsFor     Int      @default(0)
  pointsAgainst Int      @default(0)
  
  updatedAt     DateTime @updatedAt

  @@unique([seasonId, name, phase])
}

model ScoutingAiReport {
  opponentKey  String   @id
  opponentName String
  summaryMd    String   @db.Text
  analysisJson Json?
  model        String?
  sourceHash   String?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamBriefing {
  id           String   @id @default("default")
  contentMd    String   @db.Text
  model        String?
  sourceHash   String?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeagueMatch {
  id          String   @id @default(uuid())
  seasonId    String
  season      KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  date        DateTime
  homeTeam    String
  guestTeam   String
  scoreHome   Int?
  scoreAway   Int?
  isFinished  Boolean  @default(false)
  kalkMatchId String?
  roundUrl    String?
  phaseLabel  String?
  protocolUrl String?
  details     Json?
  
  updatedAt   DateTime @updatedAt

  @@index([seasonId, kalkMatchId])
}
