generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model KalkSeason {
  id           String   @id
  slug         String   @unique
  label        String
  divisionPath String   @default("dzial,dywizja-2,4.html")
  /// Numer sezonu na kalk-koszalin.com (`?sezon=`), np. 50 = 2026/2027
  kalkNumber   Int?     @unique
  /// "v2" = nowa strona (SportSync), "legacy" = stara strona
  sourceSite   String   @default("legacy")
  isActive     Boolean  @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leagueTeams   LeagueTeam[]
  leagueMatches LeagueMatch[]
  kalkPlayers   KalkPlayer[]
  kalkTeams     KalkTeam[]
  kalkMatches   KalkMatch[]
  playerGameLogs KalkPlayerGameLog[]
  games         Game[]
  preferences   PlayerSeasonPreference[]
  syncRuns      KalkSyncRun[]
  sectionSnapshots KalkSectionSnapshot[]
  preGameBriefings PreGameBriefing[]
  teamGameStats    KalkTeamGameStat[]
  playByPlayEvents KalkPlayByPlayEvent[]
  playerSeasonStats KalkPlayerSeasonStat[]
}

model Game {
  presentation Json?
  presentationUpdatedAt DateTime?
  id          String   @id @default(uuid())
  seasonId    String?
  season      KalkSeason? @relation(fields: [seasonId], references: [id])
  date        DateTime
  opponent    String
  homeAway    String   @default("home") // "home" | "away"
  result      String?  // "W" | "L" | null (if not played yet)
  scoreUs     Int?
  scoreThem   Int?
  
  // Statystyki zespołowe
  teamStats   Json?
  
  // Box score (statystyki zawodników)
  playerStats Json?
  
  // Notatki i analiza
  notes       String?
  mvp         String?
  videoUrl    String?
  tags        String[] @default([])
  
  // Stare pole dla kompatybilności wstecznej
  data        Json?

  // Analiza AI (Gemini)
  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  aiSummaryModel String?
  aiSummaryHash  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RosterPlayer {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  number       Int?
  position     String?  // "PG", "SG", "SF", "PF", "C"
  birthDate    String?
  heightCm     Int?
  starter      Boolean  @default(false)
  
  // Powiązanie z KALK
  kalkPlayerId String?  @unique
  kalkPlayer   KalkPlayer? @relation(fields: [kalkPlayerId], references: [id])
  /// Stała tożsamość KALK v2 (slug zawodnika, ten sam we wszystkich sezonach)
  kalkSlug     String?  @unique
  /// Sezony (KalkSeason.id), w których zawodnik nie gra — ukryty w składzie, rankingach i na stronie WWW
  inactiveSeasonIds String[] @default([])
  
  // Statystyki (obliczane z meczów)
  gamesPlayed  Int      @default(0)
  ppg          Float    @default(0)
  rpg          Float    @default(0)
  apg          Float    @default(0)
  fgPercentage Float    @default(0)
  threePercentage Float @default(0)
  ftPercentage Float    @default(0)
  
  // Advanced Stats
  tsPercentage Float    @default(0)
  eFgPercentage Float   @default(0)
  plusMinus    Float    @default(0)
  
  // Raw Totals (for aggregation)
  pts          Int      @default(0)
  fgm          Int      @default(0)
  fga          Int      @default(0)
  threePm      Int      @default(0)
  threePa      Int      @default(0)
  ftm          Int      @default(0)
  fta          Int      @default(0)
  orb          Int      @default(0)
  drb          Int      @default(0)
  reb          Int      @default(0)
  ast          Int      @default(0)
  stl          Int      @default(0)
  blk          Int      @default(0)
  tov          Int      @default(0)
  
  // Cele osobiste
  goals        Json?    // { "ppg": 25, "fgPercentage": 50, "turnovers": 3 }
  
  // Stare pole dla kompatybilności
  data         Json?

  // Analiza rozwoju AI (Gemini)
  aiDevelopmentSummary String?   @db.Text
  aiDevelopmentAt      DateTime?
  aiDevelopmentModel   String?
  aiDevelopmentHash    String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth
  username     String?  @unique
  password     String?
  role         String   @default("USER") // "USER" | "ADMIN"

  // Ostatnia aktywność w panelu (autoryzowane żądania API)
  lastActivityAt DateTime?
  lastActivityIp String?

  seasonPreference PlayerSeasonPreference?
}

model PlayerSeasonPreference {
  rosterPlayerId String   @id
  seasonId       String
  rosterPlayer   RosterPlayer @relation(fields: [rosterPlayerId], references: [id], onDelete: Cascade)
  season         KalkSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model LoginLog {
  id        String   @id @default(uuid())
  username  String
  success   Boolean
  ipAddress String?
  timestamp DateTime @default(now())
}

model KalkPlayer {
  id            String   @id
  seasonId      String
  /// Slug KALK v2 (bez prefiksu sezonu)
  slug          String?
  season        KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  team          String?
  pointsTotal   Float?
  pointsAverage Float?
  matchesPlayed Int?
  eval          Float?
  profileUrl    String?
  threePointStats String? // e.g. "14/40 (35%)"
  raw           Json?
  
  // Nowe kategorie statystyk ligowych
  stealsTotal      Float?
  stealsAverage    Float?
  blocksTotal      Float?
  blocksAverage    Float?
  reboundsTotal    Float?
  reboundsAverage  Float?
  assistsTotal     Float?
  assistsAverage   Float?
  threePointsMade  Int?
  threePointsAttempted Int?
  threePointsPct   Float?

  turnoversTotal     Float?
  turnoversAverage   Float?
  foulsTotal         Float?
  foulsAverage       Float?
  minutesTotal       Float?
  minutesAverage     Float?
  twoPointsPct       Float?
  ftPct              Float?
  attackIndex        Float?
  defenseIndex       Float?

  // Relacja do RosterPlayer
  rosterPlayer  RosterPlayer?
  gameLogs      KalkPlayerGameLog[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([seasonId, slug])
}

model KalkTeam {
  id         String
  seasonId   String
  season     KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  captain    String?
  colors     String?
  sponsors   String?
  profileUrl String?
  playerIds  String[] @default([])
  captainSlug String?
  logoUrl    String?
  raw        Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([seasonId, id])
}

model KalkMatch {
  presentation Json?
  presentationUpdatedAt DateTime?
  id             String
  seasonId       String
  season         KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug           String
  date           DateTime
  roundCode      String?
  matchNumber    Int?
  homeTeamId     String?
  guestTeamId    String?
  homeTeamName   String
  guestTeamName  String
  scoreHome      Int?
  scoreAway      Int?
  isFinished     Boolean  @default(false)
  referees       String?
  statistician   String?
  boxScore       Json
  meta           Json?
  contentHash    String?
  scrapedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  playerGameLogs KalkPlayerGameLog[]
  teamGameStats  KalkTeamGameStat[]
  playByPlayEvents KalkPlayByPlayEvent[]

  // KALK v2 (nowa strona): faza, kolejka, logistyka, sekcje
  stageId        Int?
  stageLabel     String?
  roundId        Int?
  roundLabel     String?
  roundNumber    Int?
  venue          String?
  startsAtUtc    DateTime?
  overtimes      Int      @default(0)
  hasPlayByPlay  Boolean  @default(false)
  sectionsAvailable String[] @default([])
  sectionHashes  Json?
  parserVersion  String?
  sourceSite     String   @default("legacy")
  mvpPlayerSlug  String?
  mvpEval        Int?
  commissioner   String?
  refereeList    String[] @default([])
  /// Prezentacja: liderzy meczu, przebieg co 5 min, obsada
  info           Json?
  /// Opcjonalne: rekordy, pojedynki, piątka meczu, P5 i rezerwowi
  extras         Json?

  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  aiSummaryModel String?
  aiSummaryHash  String?

  @@unique([seasonId, id])
  @@index([seasonId, date])
  @@index([seasonId, homeTeamId])
  @@index([seasonId, guestTeamId])
}

model KalkPlayerGameLog {
  id             String   @id @default(cuid())
  seasonId       String
  season         KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  kalkPlayerId   String
  kalkPlayer     KalkPlayer @relation(fields: [kalkPlayerId], references: [id], onDelete: Cascade)
  kalkMatchId    String
  kalkMatch      KalkMatch @relation(fields: [seasonId, kalkMatchId], references: [seasonId, id], onDelete: Cascade)
  teamName       String
  opponentName   String
  isWin          Boolean?
  stats          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // KALK v2: typowane kolumny (wszyscy zawodnicy z box score)
  playerSlug     String?
  teamKalkId     String?
  side           String?
  number         Int?
  starter        Boolean?
  secondsPlayed  Int?
  pts            Int?
  twoPm          Int?
  twoPa          Int?
  threePm        Int?
  threePa        Int?
  fgm            Int?
  fga            Int?
  ftm            Int?
  fta            Int?
  orb            Int?
  drb            Int?
  reb            Int?
  ast            Int?
  stl            Int?
  tov            Int?
  pf             Int?
  pfDrawn        Int?
  blk            Int?
  blkAgainst     Int?
  eval           Int?
  plusMinus      Int?

  @@unique([seasonId, kalkPlayerId, kalkMatchId])
  @@index([seasonId, playerSlug])
  @@index([seasonId, kalkMatchId])
}

/// Sumy drużyny w meczu (KALK v2) — typowane, do analiz i AI
model KalkTeamGameStat {
  seasonId        String
  season          KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  kalkMatchId     String
  kalkMatch       KalkMatch @relation(fields: [seasonId, kalkMatchId], references: [seasonId, id], onDelete: Cascade)
  side            String
  teamKalkId      String?
  teamName        String
  opponentKalkId  String?
  opponentName    String
  isWin           Boolean?
  pts             Int
  ptsAgainst      Int
  q1              Int?
  q2              Int?
  q3              Int?
  q4              Int?
  otPts           Int?
  minutesSec      Int?
  fgm             Int
  fga             Int
  twoPm           Int
  twoPa           Int
  threePm         Int
  threePa         Int
  ftm             Int
  fta             Int
  orb             Int
  drb             Int
  reb             Int
  ast             Int
  stl             Int
  tov             Int
  pf              Int
  pfDrawn         Int
  blk             Int
  blkAgainst      Int
  eval            Int
  startersPts     Int?
  benchPts        Int?
  ptsOffTurnovers Int?
  ptsInPaint      Int?
  secondChancePts Int?
  fastBreakPts    Int?
  updatedAt       DateTime @updatedAt

  @@id([seasonId, kalkMatchId, side])
  @@index([seasonId, teamKalkId])
}

/// Akcja po akcji (KALK v2, od sezonu 2026/2027)
model KalkPlayByPlayEvent {
  seasonId      String
  season        KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  kalkMatchId   String
  kalkMatch     KalkMatch @relation(fields: [seasonId, kalkMatchId], references: [seasonId, id], onDelete: Cascade)
  seq           Int
  period        Int
  clockSec      Int?
  elapsedSec    Int?
  side          String?
  teamKalkId    String?
  playerName    String?
  playerSlug    String?
  playerNumber  Int?
  actionRaw     String
  actionType    String
  shotValue     Int?
  made          Boolean?
  blocked       Boolean?
  reboundType   String?
  subOutNumber  Int?
  subOutSlug    String?
  scoreHome     Int
  scoreAway     Int
  isScoring     Boolean  @default(false)

  @@id([seasonId, kalkMatchId, seq])
  @@index([seasonId, playerSlug, actionType])
}

/// Statystyki sezonowe zawodnika (strona zawodnika KALK + sumy z box score)
model KalkPlayerSeasonStat {
  seasonId     String
  season       KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerSlug   String
  competition  String
  teamKey      String
  teamName     String
  teamKalkId   String?
  games        Int
  minutesTotal Int?
  pts          Int
  twoPm        Int
  twoPa        Int?
  twoPct       Float?
  threePm      Int
  threePa      Int?
  threePct     Float?
  ftm          Int
  fta          Int?
  ftPct        Float?
  orb          Int
  drb          Int
  reb          Int
  ast          Int
  stl          Int
  tov          Int
  blk          Int
  pf           Int
  pfDrawn      Int
  eval         Int
  plusMinus    Int
  source       String
  updatedAt    DateTime @updatedAt

  @@id([seasonId, playerSlug, competition, teamKey])
  @@index([seasonId, teamKalkId])
}

/// Profil zawodnika (globalny, slug KALK) — bez pełnej daty urodzenia
model KalkPlayerProfile {
  slug        String   @id
  fullName    String
  firstName   String?
  lastName    String?
  position    String?
  heightCm    Int?
  birthYear   Int?
  lastNumber  Int?
  otherCompetitions Json?
  career      Json?
  profileHash String?
  scrapedAt   DateTime?
  updatedAt   DateTime @updatedAt
}

/// Profil drużyny (globalny, ID KALK) — bilans wszech czasów
model KalkTeamProfile {
  id                   String   @id
  slug                 String
  name                 String
  sinceDate            DateTime?
  captainSlug          String?
  allTimeGames         Int?
  allTimeWins          Int?
  allTimeLosses        Int?
  allTimePointsFor     Int?
  allTimePointsAgainst Int?
  quartersWon          Int?
  quartersLost         Int?
  overtimes            Int?
  overtimeWins         Int?
  overtimeLosses       Int?
  history              Json?
  scrapedAt            DateTime?
  updatedAt            DateTime @updatedAt
}

/// Stare ID meczów (stara strona KALK) → nowe ID (v2), dla linków i AI
model KalkMatchIdAlias {
  legacyId    String @id
  seasonId    String
  kalkMatchId String
  createdAt   DateTime @default(now())

  @@index([seasonId, kalkMatchId])
}

model KalkScrapeRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  finishedAt DateTime?
  status     String
  message    String?
  filePath   String
  newPlayers Json?
  log        Json?
}

model KalkSyncRun {
  id               String   @id @default(cuid())
  seasonId         String?
  season           KalkSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  mode             String
  trigger          String?
  status           String
  httpEstimate     Int?
  sectionsChanged  String[] @default([])
  probeHashes      Json?
  errorMessage     String?
  startedAt        DateTime @default(now())
  finishedAt       DateTime?
  httpCount        Int?
  requestBudget    Int?
  parserVersion    String?
  manifest         Json?
  failures         Json?
  counts           Json?
}

model KalkSectionSnapshot {
  id          String   @id @default(cuid())
  seasonId    String
  season      KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  section     String
  contentHash String
  payload     Json
  fetchedAt   DateTime @default(now())

  @@unique([seasonId, section])
}

model Training {
  id         String   @id @default(uuid())
  date       DateTime
  focus      String[] @default([]) // ["rzuty-wolne", "obrona-pilki"]
  attendance Json?    // { "present": ["id1", "id2"], "absent": ["id3"] }
  notes      String?
  duration   Int?     // minuty
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Play {
  id            String   @id @default(uuid())
  name          String
  category      String   @default("half_court") // "half_court" | "blob" | "slob" | "ato" | "fastbreak" | "defense"
  description   String?  @db.Text
  targetDefense String?  // np. "2-3 Zone", "Man-to-Man", "Drop PnR"
  diagramData   Json?    // { tokens: [...], strokes: [...], steps: [...] }
  videoUrl      String?
  tags          String[] @default([])
  isAiGenerated Boolean  @default(false)
  
  // Statystyki skuteczności
  attempts      Int      @default(0)
  successes     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PreGameBriefing {
  id            String      @id @default(uuid())
  seasonId      String
  season        KalkSeason  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  opponentName  String
  matchDate     DateTime?
  gatheringTime String?     // np. "17:45"
  tipoffTime    String?     // np. "18:30"
  jerseyColor   String      @default("Czarne")
  venue         String      @default("Hala Sportowa, Bobolice")
  
  tacticalKeys  Json        // 3 kluczowe założenia [ { title, description, focus } ]
  startingFive  Json        // [ { playerId, name, number, position, assignment } ]
  benchKeys     String?     @db.Text
  
  generatedByAi Boolean     @default(true)
  model         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([seasonId, opponentName])
}

model LeagueTeam {
  id            String   @id @default(uuid())
  seasonId      String
  season        KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name          String
  phase         String   @default("regular") // "regular" | "playout"
  position      Int?
  matches       Int      @default(0)
  points        Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  pointsFor     Int      @default(0)
  pointsAgainst Int      @default(0)
  logoUrl       String?
  form          String?
  streak        String?
  
  updatedAt     DateTime @updatedAt

  @@unique([seasonId, name, phase])
}

model ScoutingAiReport {
  opponentKey  String   @id
  opponentName String
  summaryMd    String   @db.Text
  analysisJson Json?
  model        String?
  sourceHash   String?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamBriefing {
  id           String   @id @default("default")
  contentMd    String   @db.Text
  model        String?
  sourceHash   String?
  generatedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeagueMatch {
  id          String   @id @default(uuid())
  seasonId    String
  season      KalkSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  date        DateTime
  homeTeam    String
  guestTeam   String
  scoreHome   Int?
  scoreAway   Int?
  isFinished  Boolean  @default(false)
  kalkMatchId String?
  roundUrl    String?
  phaseLabel  String?
  protocolUrl String?
  details     Json?
  // KALK v2
  stageId           Int?
  roundId           Int?
  roundLabel        String?
  homeTeamKalkId    String?
  guestTeamKalkId   String?
  homeRecordBefore  String?
  guestRecordBefore String?
  venue             String?
  /// Dzień meczowy (wewnętrzne, nie dla strony publicznej): zbiórka, strój, uwagi trenera
  matchDay          Json?
  matchDayUpdatedAt DateTime?
  
  updatedAt   DateTime @updatedAt

  @@index([seasonId, kalkMatchId])
}

// Private BeKaPaKa Studio. Owner IDs use existing roster account identifiers.
model StudioProject {
  id String @id @default(uuid())
  ownerId String
  name String
  family String
  status String @default("draft")
  currentRevision Int @default(1)
  revisions StudioRevision[]
  jobs StudioJob[]
  exports StudioExport[]
  publicationItems StudioPublicationItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, updatedAt])
}

model StudioRevision {
  id String @id @default(uuid())
  projectId String
  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number Int
  payload Json
  contentHash String
  brandVersion String
  templateVersion String
  createdAt DateTime @default(now())
  approvals StudioApproval[]
  @@unique([projectId, number])
}

model StudioAsset {
  id String @id @default(uuid())
  ownerId String
  name String
  kind String
  status String @default("draft")
  origin String
  people String @default("")
  jerseyNumber String @default("")
  consent String @default("unknown")
  storageKey String
  mime String
  width Int
  height Int
  contentHash String
  provenance Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, status])
}

model StudioPartner {
  id String @id
  ownerId String
  name String
  assetId String?
  seedLogo String?
  status String @default("draft")
  contractNote String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, status])
}

model StudioTemplate {
  id String @id
  ownerId String
  family String
  version String
  brandVersion String
  status String @default("draft")
  approvedAt DateTime?
  @@unique([ownerId, family, version, brandVersion])
}

model StudioApproval {
  id String @id @default(uuid())
  resourceHash String?
  revisionId String
  revision StudioRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  ownerId String
  contentHash String
  createdAt DateTime @default(now())
  @@unique([revisionId, ownerId])
}

model StudioJob {
  id String @id @default(uuid())
  ownerId String
  projectId String?
  project StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revision Int?
  kind String
  status String @default("queued")
  payload Json
  result Json?
  error String?
  idempotencyKey String? @unique
  leaseToken String?
  leaseUntil DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([status, kind, createdAt])
  @@index([ownerId, projectId])
}

model StudioExport {
  id String @id @default(uuid())
  ownerId String
  projectId String
  project StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision Int
  jobId String @unique
  manifest Json
  files Json
  storageKey String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}

model StudioAiUsage {
  id String @id @default(uuid())
  ownerId String
  jobId String @unique
  month String
  reservedMicros Int
  chargedMicros Int?
  model String
  pricingVersion String
  usage Json?
  status String @default("reserved")
  createdAt DateTime @default(now())
  @@index([ownerId, month])
}

// Studio 2: one communication event (match result, tournament, partner…) published to several channels.
model StudioPublication {
  id String @id @default(uuid())
  ownerId String
  title String
  playbook String
  status String @default("draft")
  facts Json
  factsHash String
  factsConfirmedHash String?
  sourceRef Json?
  plannedAt DateTime?
  revision Int @default(1)
  items StudioPublicationItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, status, plannedAt])
}

// One channel variant: instagram_feed, instagram_story, facebook or website.
model StudioPublicationItem {
  id String @id @default(uuid())
  publicationId String
  publication StudioPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  channel String
  projectId String?
  project StudioProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  format String?
  copy Json
  copyOrigin String @default("manual")
  promptVersion String?
  status String @default("draft")
  approvedHash String?
  plannedAt DateTime?
  publishedAt DateTime?
  externalId String?
  externalUrl String?
  error String?
  revision Int @default(1)
  events StudioPublishEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([publicationId, channel])
  @@index([status, plannedAt])
}

model StudioPublishEvent {
  id String @id @default(uuid())
  itemId String
  item StudioPublicationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action String
  actor String
  payload Json?
  createdAt DateTime @default(now())
  @@index([itemId, createdAt])
}

model StudioSetting {
  ownerId String
  key String
  value Json
  updatedAt DateTime @updatedAt
  @@id([ownerId, key])
}

// AI copy for identical prompt and facts is reused instead of paid for twice.
model StudioCopyCache {
  id String @id
  ownerId String
  model String
  promptVersion String
  result Json
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}

// Bearer tokens of external agents (MCP). Only the SHA-256 is stored; agents can draft, never approve or publish.
model StudioAgentToken {
  id String @id
  ownerId String
  name String
  prefix String
  scopes String[]
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([ownerId])
}

// Provider API keys entered in Studio (AES-256-GCM with STUDIO_SECRETS_KEY). Never returned to the browser.
model StudioSecret {
  ownerId String
  provider String
  ciphertext String
  iv String
  tag String
  last4 String
  lastTestOk Boolean?
  lastTestedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([ownerId, provider])
}

model StudioSession {
  credentialHash String?
  id String @id
  ownerId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
