# Production Environment Variables (copy to .env on VPS — never commit)
NODE_ENV=production
PORT=4001

# Database
DB_PASSWORD=change-me-use-openssl-rand-base64-32
JWT_SECRET=change-me-min-32-chars-openssl-rand-base64-48

# Cron KALK (host → bkpk-backend)
KALK_CRON_SECRET=change-me

# CMS (Strapi) — required by docker-compose.prod.yml
CMS_APP_KEYS=key1,key2,key3,key4
CMS_API_TOKEN_SALT=change-me
CMS_ADMIN_JWT_SECRET=change-me
CMS_JWT_SECRET=change-me
CMS_TRANSFER_TOKEN_SALT=change-me

# Optional admin bootstrap (only if account does not exist yet)
# ADMIN_USERNAME=motylinski
# ADMIN_PASSWORD=

# Google AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ANALYSIS_ENABLED=true

# See docs/security-rotation.md after any credential leak
