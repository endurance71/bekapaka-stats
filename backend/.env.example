DATABASE_URL=postgres://bekapaka:bekapaka_pass@localhost:5433/bekapaka_stats
# Required — min 32 characters in production (no hardcoded fallback in code)
JWT_SECRET=dev-only-change-me-use-openssl-rand-base64-48
PORT=4000

# Optional: create default admin only when no admin user exists (min 12 chars)
# ADMIN_USERNAME=motylinski
# ADMIN_PASSWORD=

# Cron KALK sync (production / VPS)
# KALK_CRON_SECRET=

# One-off scripts only (seed-users.js) — never commit real values
# SEED_DEFAULT_PASSWORD=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
AI_ANALYSIS_ENABLED=true
