DATABASE_URL=postgres://bekapaka:bekapaka_pass@localhost:5433/bekapaka_stats
# Required — min 32 characters in production (no hardcoded fallback in code)
JWT_SECRET=dev-only-change-me-use-openssl-rand-base64-48
PORT=4000

# Optional: create default admin only when no admin user exists (min 12 chars)
# ADMIN_USERNAME=motylinski
# ADMIN_PASSWORD=

# Cron KALK sync (production / VPS)
# KALK_CRON_SECRET=

# One-off scripts only (seed-users.js) — never commit real values
# SEED_DEFAULT_PASSWORD=

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
AI_ANALYSIS_ENABLED=true

# Claude Agent SDK — alternatywny silnik tekstów AI (Ustawienia → Dostawca AI w panelu i Studio).
# Klucz API z Claude Console (platform.claude.com), np. z organizacji podpiętej do planu Max/Team (miesięczne kredyty API).
# NIGDY token logowania subskrypcji (CLAUDE_CODE_OAUTH_TOKEN / sk-ant-oat…) — serwer go odrzuci. Pusty = silnik SDK wyłączony.
AGENT_SDK_ANTHROPIC_API_KEY=
# Górny limit kosztu jednej generacji panelu przez SDK (USD); Studio używa swojego budżetu miesięcznego.
AGENT_SDK_PANEL_MAX_USD=0.5
