# Add these values to the backend environment. No secrets in Git.
STUDIO_OWNER_ID=
STUDIO_ORIGIN=http://localhost:5174
STUDIO_STORAGE_DIR=../data/studio
STUDIO_PYTHON=./studio/.venv/bin/python
STUDIO_CMS_URL=http://localhost:1337
# Separate read-only API token with access to published events/news/media only.
STUDIO_CMS_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts provider keys entered in Studio → Ustawienia.
STUDIO_SECRETS_KEY=
# Optional fallbacks when no key is stored in Studio.
STUDIO_GEMINI_API_KEY=
STUDIO_ANTHROPIC_API_KEY=
STUDIO_OPENAI_API_KEY=
STUDIO_AI_TEXT_MODEL=gemini-3.5-flash
STUDIO_AI_IMAGE_MODEL=gemini-3.1-flash-image
STUDIO_AI_BUDGET_USD=10
