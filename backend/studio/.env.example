STUDIO_CMS_TOKEN=
STUDIO_GEMINI_API_KEY=
STUDIO_AI_TEXT_MODEL=gemini-3.5-flash
STUDIO_AI_IMAGE_MODEL=gemini-3.1-flash-image
STUDIO_AI_BUDGET_USD=10
