FROM node:22-alpine AS deps
WORKDIR /app/site
COPY site/package.json site/package-lock.json* ./
RUN npm install

FROM node:22-alpine AS build
WORKDIR /app/site
COPY packages/design-tokens /app/packages/design-tokens
COPY packages/safari-overlay /app/packages/safari-overlay
RUN cd /app/packages/safari-overlay && npm ci
COPY --from=deps /app/site/node_modules ./node_modules
COPY site/ .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/site/.next/standalone ./
COPY --from=build /app/site/.next/static ./site/.next/static
COPY --from=build /app/site/public ./site/public
EXPOSE 3000
CMD ["node", "site/server.js"]
