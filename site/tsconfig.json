{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@bekapaka/safari-overlay": ["../packages/safari-overlay/index.ts"],
      "@bekapaka/safari-overlay/*": ["../packages/safari-overlay/*"],
      "react": ["./node_modules/react"],
      "react-dom": ["./node_modules/react-dom"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../packages/safari-overlay/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
