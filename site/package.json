{
  "name": "bekapaka-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run build",
    "preview:local": "node scripts/preview-local.mjs",
    "qa:layout": "uv run --with playwright python scripts/qa-layout.py http://127.0.0.1:3200",
    "qa:mobile": "uv run --with playwright python scripts/qa-mobile.py http://127.0.0.1:3200"
  },
  "dependencies": {
    "micromark-util-character": "^2.1.1",
    "next": "^16.3.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
