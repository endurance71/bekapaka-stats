[Unit]
Description=Schedule BeKaPaKa KALK full sync

[Timer]
# Codziennie rano + wieczorem w dni meczowe (KALK gra w weekendy; wyniki i nowe terminy szybciej na stronie).
OnCalendar=*-*-* 07:30:00 Europe/Warsaw
OnCalendar=Sat,Sun *-*-* 21:00:00 Europe/Warsaw
AccuracySec=1min
Unit=bekapaka-kalk-sync.service

[Install]
WantedBy=timers.target
