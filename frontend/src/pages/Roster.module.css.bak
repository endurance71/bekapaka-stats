/* Main Layout */
.page {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 24px;
  height: calc(100vh - 100px);
  /* Fit viewport minus layout header */
  overflow: hidden;
}

/* --- LEFT: Player List --- */
.listPanel {
  background: var(--surface);
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.listHeader {
  padding: 20px 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0) 100%);
}

.listHeader h1 {
  font-size: 24px;
  margin-bottom: 6px;
  background: linear-gradient(90deg, #fff, #9aa6c3);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.scrollArea {
  overflow-y: auto;
  flex: 1;
  padding: 12px;
}

/* Player List Table */
.table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 4px;
}

.table th {
  padding: 8px 16px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  font-weight: 700;
  border-bottom: none;
}

.tableRow {
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  border-radius: 12px;
  position: relative;
}

.tableRow td {
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.02);
  border: none;
  font-weight: 500;
  color: var(--text-muted);
}

/* First & Last cells radius for "row" effect */
.tableRow td:first-child {
  border-radius: 12px 0 0 12px;
}

.tableRow td:last-child {
  border-radius: 0 12px 12px 0;
}

.tableRow.active td {
  background: rgba(44, 123, 255, 0.15);
  color: #fff;
  border-top: 1px solid rgba(44, 123, 255, 0.3);
  border-bottom: 1px solid rgba(44, 123, 255, 0.3);
}

.tableRow.active td:first-child {
  border-left: 1px solid rgba(44, 123, 255, 0.3);
}

.tableRow.active td:last-child {
  border-right: 1px solid rgba(44, 123, 255, 0.3);
}

.tableRow:hover:not(.active) td {
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
}

.nameCell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.miniNumber {
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
  color: var(--accent);
  width: 20px;
}

/* --- RIGHT: Details Panel --- */
.detailsPanel {
  background: var(--surface);
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  overflow-y: auto;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* Banner Header */
.detailsHeader {
  position: relative;
  height: 200px;
  background: radial-gradient(circle at top right, rgba(44, 123, 255, 0.2), transparent 60%),
    linear-gradient(135deg, #0f1523 0%, #080b12 100%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding: 30px 40px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

/* Floating Photo */
.playerPhoto {
  position: absolute;
  top: 40px;
  right: 40px;
  width: 160px;
  height: 160px;
  border-radius: 24px;
  border: 4px solid rgba(18, 26, 45, 0.8);
  /* Match darker bg for seamless look */
  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6);
  overflow: hidden;
  z-index: 10;
  background: #000;
}

.playerPhoto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}

.playerInfo h2 {
  font-size: 32px;
  line-height: 1.1;
  margin-bottom: 8px;
  background: linear-gradient(90deg, #fff, #e0e6ed);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.metaTags {
  display: flex;
  gap: 10px;
}

.tag {
  padding: 6px 14px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  font-size: 13px;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.tag.accent {
  background: rgba(255, 122, 0, 0.15);
  color: var(--accent);
  border-color: rgba(255, 122, 0, 0.3);
}

/* Content Area */
.detailsContent {
  padding: 40px;
  padding-top: 40px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Stats Grid */
.statsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.statCard {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition: transform 0.2s;
}

.statCard:hover {
  background: rgba(255, 255, 255, 0.05);
  transform: translateY(-2px);
}

.statLabel {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  font-weight: 700;
}

.statValue {
  font-size: 28px;
  font-family: 'Outfit', sans-serif;
  /* If available, or system */
  font-weight: 700;
  color: #fff;
}

.statValue small {
  font-size: 14px;
  color: var(--text-muted);
  margin-left: 2px;
}

/* Sections */
.sectionTitle {
  font-size: 18px;
  margin-bottom: 16px;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 12px;
}

.sectionTitle::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.1);
}

/* Game Log Table (reuse elegant styles) */
.logTable {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.logTable th {
  text-align: left;
  padding: 12px;
  color: var(--text-muted);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  font-weight: 600;
}

.logTable td {
  padding: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: #e0e6ed;
}

.logTable tr:last-child td {
  border-bottom: none;
}

@media (max-width: 1100px) {
  .page {
    grid-template-columns: 1fr;
    height: auto;
    overflow: visible;
  }

  .listPanel {
    height: 400px;
  }

  .detailsPanel {
    height: auto;
  }

  .playerPhoto {
    position: relative;
    top: 0;
    right: 0;
    margin: 0 auto 20px;
  }

  .detailsHeader {
    flex-direction: column-reverse;
    /* Photo on top */
    align-items: center;
    text-align: center;
    height: auto;
  }
}